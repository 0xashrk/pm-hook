# Webhook destination (POST JSON with Authorization: Bearer <WEBHOOK_KEY>)
WEBHOOK_URL=https://example.com/hooks/polymarket-price
WEBHOOK_KEY=replace-me

# Alert when Yes (or 5m side) price >= THRESHOLD
THRESHOLD=0.90

# Force WS reconnect if no market messages for this many seconds
STALE_SECS=5

# Monthly ladder: prefer / require spread = best_ask - best_bid <= MAX_SPREAD
MAX_SPREAD=0.05

# Monthly / soccer: Gamma re-resolve interval (seconds). 5m watcher uses a shorter fixed rollover.
REFRESH_SECS=90

# Soccer leagues to watch (comma): epl, lal, mls
LEAGUES=epl,lal,mls

# Soccer: include upcoming kickoffs within this many hours
HORIZON_HOURS=48

# Soccer: treat Gamma endDate/kickoff + this window as in-play
MATCH_DURATION_HOURS=3

# Soccer: alert when mark moves >= N cents (0 disables)
DELTA_ALERT_CENTS=0

# Soccer: always watch these event or market slugs (comma)
# POSITION_SLUGS=epl-sun-ars-2026-09-12

# Soccer: always watch these Gamma market ids (comma)
# WATCH_MARKET_IDS=

# Soccer: skip extreme Yes for non-position markets
MIN_YES=0.02
MAX_YES=0.98

# Optional: which script supervise.sh runs (default watch_monthly.py)
# WATCH_SCRIPT=watch_monthly.py
# WATCH_SCRIPT=watch_crypto_5m.py
# WATCH_SCRIPT=watch_soccer.py
